{
  "name": "amm-arbitrageur",
  "version": "2.0.0",
  "description": "Atomic arbitrage between Uniswap-V2-style AMMs, funded by flash swaps",
  "license": "WTFPL",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:ts": "tsc --noEmit",
    "fmt": "prettier --write 'contracts/**/*.sol' '{bot,test,scripts}/**/*.ts'",
    "fmt:check": "prettier --check 'contracts/**/*.sol' '{bot,test,scripts}/**/*.ts'",
    "bot": "hardhat run bot/index.ts --network bsc",
    "deploy": "hardhat run scripts/deploy.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@types/async-lock": "^1.4.2",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.1",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.17",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.1",
    "solhint": "^5.0.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ricokahler/pool": "^1.1.2",
    "async-lock": "^1.4.1",
    "lodash": "^4.17.21",
    "lodash.combinations": "^18.10.0",
    "winston": "^3.17.0"
  }
}

# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.

# Deployed FlashBot address the bot should drive.
FLASHBOT_ADDRESS=

# Signer for deployment and for sending arbitrage transactions.
PRIVATE_KEY=

# RPC endpoints.
BSC_RPC_URL=https://bsc-dataseed1.binance.org
# Archive node, only needed to run the mainnet-fork tests.
BSC_ARCHIVE_RPC_URL=

# Etherscan V2 multichain key, used to price the base token in USD.
# The old per-chain bscscan.com endpoint this project shipped is being retired.
ETHERSCAN_API_KEY=

# Bot tuning.
MIN_PROFIT_USD=50
GAS_PRICE_GWEI=10
GAS_LIMIT=300000
MAX_CONCURRENCY=20
LOG_LEVEL=info
